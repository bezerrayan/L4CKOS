FROM node:22-alpine AS deps
WORKDIR /app

COPY ops/staging-maintenance/package.json \
     ops/staging-maintenance/package-lock.json ./

RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22-alpine

ENV NODE_ENV=production
ENV PORT=3010
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules

COPY --chown=node:node \
  ops/staging-maintenance/package.json \
  ops/staging-maintenance/guard.mjs \
  ops/staging-maintenance/http.mjs \
  ops/staging-maintenance/server.mjs \
  ./

USER node
EXPOSE 3010
CMD ["node", "server.mjs"]
