# Template only. Never commit actual credentials or copy secrets from production.

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Technical Node mode. Deployed backend must use production optimizations.
NODE_ENV=production
# Canonical operational identity. Do not rely on NODE_ENV or platform inference.
APP_ENV=staging
# Public release identity included in health, version and structured logs.
RELEASE_VERSION=staging-candidate-YYYYMMDD.N
GIT_COMMIT_SHA=REPLACE_WITH_FULL_COMMIT_SHA
DEPLOYED_AT=YYYY-MM-DDTHH:MM:SSZ
APP_ID=l4ckos-staging
VITE_APP_ID=l4ckos-staging
VITE_APP_ENV=staging
VITE_APP_TITLE=L4CKOS Staging
VITE_COMING_SOON=false
HOST=0.0.0.0
PORT=3010

# Operational gates. Start with checkout closed; open it only after smoke tests.
CHECKOUT_ENABLED=false
MAINTENANCE_MODE=false

# -----------------------------------------------------------------------------
# Banco
# -----------------------------------------------------------------------------
# Dedicated staging database; never reuse a production host, database or user.
DATABASE_URL=mysql://STAGING_USER:STAGING_PASSWORD@staging-db.example.invalid:3306/l4ckos_staging
EXPECTED_DATABASE_HOST=staging-db.example.invalid
EXPECTED_DATABASE_NAME=l4ckos_staging
# Non-secret production identifiers used only by fail-closed comparison.
PRODUCTION_DATABASE_HOST=production-db.example.invalid
PRODUCTION_DATABASE_NAME=l4ckos_production

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Unique staging signing secret, generated in the staging secret manager.
JWT_SECRET=
SESSION_SECRET_ENV=staging
SESSION_TTL_HOURS=12
# Host-only cookie. SESSION_COOKIE_DOMAIN must remain empty.
SESSION_COOKIE_NAME=l4ckos_staging_session
PRODUCTION_SESSION_COOKIE_NAME=l4ckos_production_session
SESSION_COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Controlled staging accounts. Passwords are supplied only when running the seed.
STAGING_CLIENT_EMAIL=cliente-staging@example.test
STAGING_CLIENT_PASSWORD=
STAGING_ADMIN_EMAIL=admin-staging@example.test
STAGING_ADMIN_PASSWORD=
ADMIN_EMAILS=admin-staging@example.test
LOCAL_AUTH_ALLOWED_EMAILS=cliente-staging@example.test,admin-staging@example.test
ALLOW_LOCAL_AUTH_IN_PRODUCTION=true
ALLOW_PUBLIC_LOCAL_SIGNUP_IN_PRODUCTION=false

# Dedicated Google OAuth client and callback for staging, if OAuth is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ENV=staging
GOOGLE_REDIRECT_URI=https://api-staging.l4ckos.com.br/api/oauth/callback
OWNER_OPEN_ID=

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=https://staging.l4ckos.com.br
APP_URL=https://staging.l4ckos.com.br
APP_BASE_URL=https://staging.l4ckos.com.br
API_PUBLIC_URL=https://api-staging.l4ckos.com.br
VITE_API_URL=https://api-staging.l4ckos.com.br
EXPECTED_FRONTEND_ORIGIN=https://staging.l4ckos.com.br
EXPECTED_API_ORIGIN=https://api-staging.l4ckos.com.br
PRODUCTION_FRONTEND_ORIGIN=https://l4ckos.com.br
PRODUCTION_API_ORIGIN=https://api.l4ckos.com.br
CORS_ORIGINS=https://staging.l4ckos.com.br

# -----------------------------------------------------------------------------
# Asaas
# -----------------------------------------------------------------------------
# Sandbox account and key must be independent from production.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHECKOUT_BASE_URL=https://sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_WEBHOOK_ENV=staging

# -----------------------------------------------------------------------------
# Resend
# -----------------------------------------------------------------------------
# Restricted mode blocks and logs any recipient outside the explicit allowlist.
EMAIL_MODE=restricted
EMAIL_ENV=staging
RESEND_API_KEY=
STAGING_EMAIL_ALLOWLIST=qa-owner@example.test,delivered@resend.dev
EMAIL_FROM=
EMAIL_FROM_NOREPLY=
EMAIL_FROM_CONTACT=
EMAIL_FROM_SALES=
EMAIL_FROM_FINANCE=
EMAIL_REPLY_TO=
EMAIL_TO_CONTACT=
EMAIL_TO_SALES=
EMAIL_TO_FINANCE=
ALERTS_NOTIFICATION_EMAIL=
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_SIGNATURE_WEBSITE=https://staging.l4ckos.com.br
EMAIL_SIGNATURE_LOGO_URL=https://staging.l4ckos.com.br/email/logo-assinatura.png

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Recommended staging mode. Use an exclusive proxy/account and namespace.
STORAGE_MODE=remote
STORAGE_ENV=staging
STORAGE_NAMESPACE=l4ckos-staging
PRODUCTION_STORAGE_NAMESPACE=l4ckos-production
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Set true only if staging intentionally uses its own ephemeral local volume.
ALLOW_EPHEMERAL_STAGING_STORAGE=false

# -----------------------------------------------------------------------------
# Frete
# -----------------------------------------------------------------------------
MELHOR_ENVIO_API_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=staging
MELHOR_ENVIO_FROM_POSTAL_CODE=
LOCAL_DELIVERY_CEP_PREFIXES=

# -----------------------------------------------------------------------------
# Jobs
# -----------------------------------------------------------------------------
# Chosen staging model: external scheduler calls protected endpoints. The backend
# never starts internal timers in this mode, preventing duplicate execution.
OPERATIONAL_JOBS_ENABLED=true
JOB_SCHEDULER_MODE=external
JOB_ENDPOINTS_ENABLED=true
CRON_SECRET=
CRON_SECRET_ENV=staging
RESERVATION_JOB_INTERVAL_MS=60000
OUTBOX_JOB_INTERVAL_MS=15000
RECONCILIATION_JOB_INTERVAL_MS=300000

# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------
# Keep disabled until BACKUP_DIR is persistent and restore has been rehearsed.
AUTOMATIC_BACKUPS_ENABLED=false
BACKUP_DIR=/app/backups

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=info
OTEL_SERVICE_NAME=l4ckos-backend-staging
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Segurança / rate limit
# -----------------------------------------------------------------------------
# Defaults remain production-like; raise only for a documented concurrency test.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
PUBLIC_WRITE_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_MAX=120
CONTACT_TEST_ENABLED=false
