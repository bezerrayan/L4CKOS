{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm exec vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/csrf",
      "destination": "/api/staging-bff?bffpath=csrf"
    },
    {
      "source": "/api/shipping/quote",
      "destination": "/api/staging-bff?bffpath=shipping/quote"
    },
    {
      "source": "/api/cep/:cep(\\d{8})",
      "destination": "/api/staging-bff?bffpath=cep/:cep"
    },
    {
      "source": "/api/trpc/:procedure*",
      "destination": "/api/staging-bff?bffpath=trpc/:procedure*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
